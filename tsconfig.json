{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": ".",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Path Mapping (Merged cleanly without baseUrl)
    "paths": {
      "@/*": ["./src/*"]
    },

    // Other Outputs
    // This is a Node.js application, not a published npm library:
    //   - sourceMap   -> disabled (no *.js.map in production output)
    //   - declaration -> disabled (no *.d.ts in production output)
    //   - declarationMap -> disabled (no *.d.ts.map in production output)

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "config/**/*.ts",
    "controller/**/*.ts",
    "lib/**/*.ts",
    "middlewares/**/*.ts",
    "routes/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "prisma.config.ts", "neon.ts"]
}
